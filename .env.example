# User
# Run `id` in your terminal to find your PUID and PGID
PUID=501
PGID=20

# Ports
JELLYFIN_PORT=8096
QBITTORRENT_PORT=8080
SONARR_PORT=8989
RADARR_PORT=7878
RADARR_EXTRA_PORT=7879
PROWLARR_PORT=9696
FLARESOLVERR_PORT=8191
JELLYSEERR_PORT=5055
SABNZBD_PORT=8085
TORRENT_PORT=6881
HOMEPAGE_PORT=3000

# Paths
# Path to your media storage volume
DATA_PATH=/Volumes/YourDrive/media

# Homepage widget API keys
# HOMEPAGE_VAR_HOST is your Tailscale IP or local IP
HOMEPAGE_VAR_HOST=100.x.x.x
HOMEPAGE_VAR_JELLYFIN_API_KEY=your_jellyfin_api_key
HOMEPAGE_VAR_JELLYSEERR_API_KEY=your_jellyseerr_api_key
HOMEPAGE_VAR_SONARR_API_KEY=your_sonarr_api_key
HOMEPAGE_VAR_RADARR_API_KEY=your_radarr_api_key
HOMEPAGE_VAR_RADARR_EXTRA_API_KEY=your_radarr_extra_api_key
HOMEPAGE_VAR_PROWLARR_API_KEY=your_prowlarr_api_key
HOMEPAGE_VAR_QBIT_USER=admin
HOMEPAGE_VAR_QBIT_PASS=your_qbittorrent_password
